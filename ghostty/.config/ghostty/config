mouse-scroll-multiplier = 0.8

# Switch back to TokyoNight by swapping these lines
# theme = TokyoNight
theme = dark-2026

# Shift+Enter as CSI-u so TUI agents (pi, Claude Code) can distinguish it from Enter.
# The old esc+CR mapping arrived in pi as Alt+Enter (follow-up), not a newline.
keybind = shift+enter=text:\x1b[13;2u

